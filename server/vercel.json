{
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/api/cron?job=subscription-expiry", "schedule": "30 19 * * *" },
    { "path": "/api/cron?job=overdue-reminders", "schedule": "0 4 * * *" },
    { "path": "/api/cron?job=session-cleanup", "schedule": "0 21 * * *" }
  ],
  "functions": { "api/*.js": { "maxDuration": 30 } }
}
