{
  "name": "eleviq-sfa",
  "version": "1.0.0",
  "description": "ElevIQ SFA - Multi-Tenant Sales Force Automation, Order & Invoice SaaS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
