# ============================================================
# ElevIQ SFA - Environment Configuration
#
# NOTE: the Express server reads `server/.env` (see server/.env.example).
# Copy that file there and fill in the values; this root copy is kept as a
# reference for the whole monorepo.
# NEVER commit a real .env file.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB Atlas) ----
# Connection comes ONLY from here. Never hardcode credentials.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=SFA_ERP

# ---- Auth / JWT ----
# Use long random strings (e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_IMPERSONATE_EXPIRES=30m

# ---- Cookies / Security ----
COOKIE_SECURE=false          # true in production (HTTPS)
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- Platform (Service Provider) Super Admin ----
# Credentials for the seed super admin. Not hardcoded anywhere.
SUPER_ADMIN_EMAIL=superadmin@eleviqsfa.com
SUPER_ADMIN_PASSWORD=ChangeMe#SuperAdmin1
SUPER_ADMIN_NAME=ElevIQ Platform Admin

# ---- File Uploads ----
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=logs

# ---- Invoicing / PDF ----
INVOICE_PDF_FONT=Helvetica

# ---- Optional Integrations (leave blank to disable) ----
SMTP_URL=
SMS_API_KEY=
WHATSAPP_API_TOKEN=
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
